APP_NAME="Clio iManage"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
# Use MySQL/PostgreSQL in production; SQLite is fine for local dev
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clio_imanage
DB_USERNAME=root
DB_PASSWORD=

# ─── Session / Cache / Broadcast ──────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Queue ────────────────────────────────────────────────────────────────────
# Use redis + Horizon in production (required for long_term / imanage / webhooks queues)
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=clio_imanage_

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Horizon ──────────────────────────────────────────────────────────────────
# HORIZON_DOMAIN=
# HORIZON_PATH=horizon

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Clio OAuth ───────────────────────────────────────────────────────────────
# Register your app at https://app.clio.com/settings/developer_applications
# Per-tenant app credentials are stored in the tenants table (encrypted).
# The redirect URI must match exactly what is registered in Clio.
CLIO_REDIRECT_URI=http://localhost:8000/oauth/clio/callback

# ─── iManage OAuth ────────────────────────────────────────────────────────────
# Register your app in your iManage Cloud tenant Developer Portal.
# Per-tenant app credentials are stored in the tenants table (encrypted).
# The redirect URI must match exactly what is registered in iManage.
IMANAGE_REDIRECT_URI=http://localhost:8000/oauth/imanage/callback

# ─── Passkeys (WebAuthn) ──────────────────────────────────────────────────────
# Generate with: php artisan tinker --execute="echo base64_encode(random_bytes(32));"
PASSKEYS_USER_HANDLE_SECRET=

# ─── Sanctum ──────────────────────────────────────────────────────────────────
# Comma-separated list of domains that can make stateful API requests
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# ─── AWS (optional — only needed if using S3 for file storage) ────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
